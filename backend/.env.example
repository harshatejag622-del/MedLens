# ==============================================================================
# MedLens Production Environment Configuration (.env.example)
# IMPORTANT: Copy this file to .env and configure real production values.
# NEVER commit raw secrets or production credentials to version control.
# ==============================================================================

# Application Metadata
APP_NAME="MedLens Clinical Intelligence"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False

# Security & Cryptography
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION"
API_V1_STR="/api"

# Database Configuration
# SQLite: sqlite:///./medlens.db
# PostgreSQL: postgresql://medlens_user:secure_password@postgres-host:5432/medlens_db
DATABASE_URL="sqlite:///./medlens.db"

# Secure Document Storage
STORAGE_DIR="./storage/documents"
MAX_UPLOAD_SIZE_MB=25

# AI Provider Configuration
# Options: 'local' (deterministic clinical NLP) or 'gemini' (Google Gemini AI)
AI_PROVIDER="local"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Demonstration Mode
# Set to False in production to disable automatic demo data seeding
DEMO_MODE=False

# CORS Allowed Origins
CORS_ORIGINS=["https://medlens.yourdomain.org"]
